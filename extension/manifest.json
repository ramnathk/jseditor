{
  "manifest_version": 3,
  "name": "Game Value Editor",
  "version": "0.1.1",
  "description": "Find, narrow down, and edit accessible JavaScript values in the current page. WASM is not supported.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Game Value Editor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
